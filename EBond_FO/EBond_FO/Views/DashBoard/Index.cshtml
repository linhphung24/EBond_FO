@model IEnumerable<EBond_FO.Models.IFG_Corporate_Bond_Info>

@{
    ViewData["Title"] = "Thị trường trái phiếu";
}

<div class="c_ikmhbz c_pni6vl">
    <div class="c_h3i80m">
        <div>
            <h2 class="c_78my79">Thị trường trái phiếu</h2>
        </div>
    </div>

    <div class="c_cgfqtw">
        <!-- ===== DESKTOP BOND TABLE ===== -->
        <div class="table-wrapper">
            <table>
                <thead>
                    <tr class="filter-row">
                        <th colspan="12">
                            <form method="get" asp-action="Index">
                                <div class="filter-bar">
                                    <div class="filter-item">
                                        <span class="label">Trái phiếu:</span>
                                        <input type="text"
                                               name="keyword"
                                               placeholder="Nhập mã hoặc tên trái phiếu"
                                               value="@Context.Request.Query["keyword"]" />
                                    </div>

                                    <div class="filter-item">
                                        <span class="label">Trạng thái:</span>
                                        <select name="securityTradingStatus">
                                            <option value="">Tất cả</option>
                                            @foreach (var s in ViewBag.AllStatus)
                                            {
                                                <option value="@s.ID"
                                                        selected="@(Context.Request.Query["securityTradingStatus"] == s.ID)">
                                                    @s.Description
                                                </option>
                                            }
                                        </select>
                                    </div>

                                    <button type="submit" class="filter-btn">LỌC</button>

                                </div>
                            </form>
                        </th>
                    </tr>
                    <tr>
                        <th>Mã TP</th>
                        <th>Tên</th>
                        <th>TCPH</th>
                        <th>Lãi suất (%)</th>
                        <th>Ngày phát hành</th>
                        <th>Ngày đáo hạn</th>
                        <th>Kỳ hạn</th>
                        <th>Còn lại</th>
                        <th>Mệnh giá</th>
                        <th>Giá khớp</th>
                        <th>KL khớp</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody id="bond-tbody">
                    @foreach (var bond in Model)
                    {
                        <tr data-tcph="@bond.TCPH" data-status="@bond.SecurityTradingStatus">
                            <td>@bond.Symbol</td>
                            <td>@bond.Name</td>
                            <td>@bond.TCPH</td>
                            <td>@bond.INTEREST_RATE</td>
                            <td>@string.Format("{0:dd/MM/yyyy}", bond.IssueDate)</td>
                            <td>@string.Format("{0:dd/MM/yyyy}", bond.MaturityDate)</td>
                            <td>@bond.BOND_PERIOD @bond.PERIOD_UNIT</td>
                            <td>@bond.PERIOD_REMAIN</td>
                            <td>@(bond.Parvalue?.ToString("N0"))</td>
                            <td>@bond.MatchPrice</td>
                            <td>@bond.MatchQtty</td>
                            <td>@bond.SecurityTradingStatusText</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="legend-row">
                        <td colspan="12">
                            <div class="legend-bar">
                                <span>Tổng: <strong>@Model.Count()</strong> trái phiếu</span>
                            </div>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>
</div>
